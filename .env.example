# Beyond AI — Environment Configuration
# Copy to .env and adjust values

# ── Neo4j ──
NEO4J_PASSWORD=

# ── yente / Elasticsearch ──
# Use a strong URL-safe password because it is embedded into YENTE_INDEX_URL.
YENTE_ES_PASSWORD=

# ── Beyond AI access protection ──
BEYOND_AI_BASIC_AUTH_USER=
BEYOND_AI_BASIC_AUTH_PASSWORD=
BEYOND_AI_AUTH_REQUIRED=true
BEYOND_AI_RATE_LIMIT_REQUESTS=30
BEYOND_AI_RATE_LIMIT_WINDOW_SECONDS=60

# ── Ollama (Primary LLM) ──
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=kimi-k2.5

# ── Claude API (Fallback LLM) ──
ANTHROPIC_API_KEY=
BEYOND_AI_ALLOW_EXTERNAL_LLM_FALLBACK=false

# ── OpenSanctions ──
# Nur für kommerzielle Nutzung:
# OPENSANCTIONS_TOKEN=

# ── Telegram Alerts ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
