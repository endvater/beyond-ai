# Beyond AI — Produktions-Umgebungsvariablen
# Kopieren nach .env:  cp .env.prod.example .env

# ─── Neo4j (bestehende neo4j4ruth-Instanz) ────────────────────
# Container-Namen prüfen: docker ps --format '{{.Names}}' | grep neo4j
NEO4J_CONTAINER_NAME=neo4j
NEO4J_PASSWORD=DEIN_NEO4J_PASSWORT_HIER

# ─── Ollama (bestehende ollama-eksw-Instanz) ──────────────────
# Container-Namen prüfen: docker ps --format '{{.Names}}' | grep ollama
OLLAMA_CONTAINER_NAME=ollama-eksw-ollama-1

# ─── Optional: Claude API als LLM-Fallback ────────────────────
ANTHROPIC_API_KEY=
